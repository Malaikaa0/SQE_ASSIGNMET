# Copy this file to .env and adjust as needed.

# --- PostgreSQL connection ---
PGHOST=127.0.0.1
PGPORT=5000
PGDATABASE=library_admin_system
PGUSER=libraryuser
PGPASSWORD=library123

# --- Server ---
HTTPS_PORT=8443
HTTP_PORT=8080
# If true, an HTTP server also runs and permanently redirects to HTTPS (Req 6510/6511).
ENABLE_HTTP_REDIRECT=true

# --- Auth ---
JWT_SECRET=change-this-super-secret-value-in-production
JWT_EXPIRES_IN=8h

# --- Record locking (Req 6513 / 7302) ---
DEFAULT_LOCK_TIMEOUT_MINUTES=15

# --- System monitoring (Req 6501) ---
MONITOR_INTERVAL_SECONDS=10
# Minutes to wait before re-alerting on the same metric at the same level.
ALERT_COOLDOWN_MINUTES=5
# SMTP is optional. If not configured, email alerts are logged instead of sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=library-alerts@example.com
ALERT_EMAIL_TO=admin@example.com
